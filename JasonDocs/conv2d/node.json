  "docs": {
    "title": {
      "en": "Conv2D",
      "ru": "Свёрточный слой",
      "kz": "2D свертка"
    },
    "summary": {
      "en": "Extracts spatial patterns from images or two-dimensional feature maps.",
      "ru": "Просматривает изображение небольшими окнами и ищет знакомые детали.",
      "kz": "Кескіндерден немесе екі өлшемді карталардан кеңістік белгілерін шығарады."
    },
    "operation": {
      "en": "Slides trainable filters across the input. Filter count controls output channels, window controls kernel size, stride controls movement, and an optional Activation node selects the nonlinearity.",
      "ru": "Свёрточный слой двигает по изображению небольшие окна-фильтры. Каждый фильтр учится замечать свой вид детали: например, край, угол или простую форму. На выходе получается несколько новых сеток чисел. Большое число в такой сетке означает, что в этом месте фильтр заметил знакомую деталь.",
      "kz": "Үйретілетін сүзгілерді кіріс бойымен жылжытады. Сүзгі саны шығыс арналарын, терезе ядро өлшемін, қадам жылжуды анықтайды, ал Activation сызықтық емес функцияны таңдайды."
    },
    "compact": {
      "body": {
        "en": "Extracts spatial patterns from images or two-dimensional feature maps.",
        "ru": "Ищет детали в разных участках изображения.",
        "kz": "Кескіндерден немесе екі өлшемді карталардан кеңістік белгілерін шығарады."
      }
    },
    "ports": {
      "input_activ_activ_in": {
        "label": {
          "en": "activ_in",
          "ru": "Функция активации",
          "kz": "activ_in"
        },
        "description": {
          "en": "Receives activation data through the activ_in input.",
          "ru": "Синий порт сверху принимает правило обработки ответов фильтров, например ReLU.",
          "kz": "activ_in кірісі арқылы activation түріндегі деректерді қабылдайды."
        }
      },
      "input_ni_layer_in": {
        "label": {
          "en": "layer_in",
          "ru": "Изображение",
          "kz": "layer_in"
        },
        "description": {
          "en": "Receives input2d, layer2d data through the layer_in input.",
          "ru": "Оранжевый порт слева принимает изображение или сетки, созданные предыдущим свёрточным слоем.",
          "kz": "layer_in кірісі арқылы input2d, layer2d түріндегі деректерді қабылдайды."
        }
      },
      "output_o_layer_out": {
        "label": {
          "en": "layer_out",
          "ru": "Найденные детали",
          "kz": "layer_out"
        },
        "description": {
          "en": "Sends layer2d data to compatible downstream nodes.",
          "ru": "Оранжевый порт справа передаёт сетки, которые показывают, где фильтры нашли знакомые детали.",
          "kz": "layer2d түріндегі деректерді үйлесімді келесі түйіндерге береді."
        }
      }
    },
    "settings": {
      "filters": {
        "label": {
          "en": "filters",
          "ru": "Количество фильтров",
          "kz": "filters"
        },
        "description": {
          "en": "Sets the number of learned output filters.",
          "ru": "Задаёт, сколько разных видов деталей слой сможет искать одновременно. Каждый фильтр создаёт свою сетку ответов.",
          "kz": "Үйретілетін шығыс сүзгілерінің санын анықтайды."
        }
      },
      "stride": {
        "label": {
          "en": "stride",
          "ru": "Шаг",
          "kz": "stride"
        },
        "description": {
          "en": "Sets how far the convolution window moves per step.",
          "ru": "Задаёт, на сколько пикселей окно сдвигается за один раз. Большой шаг обрабатывает изображение быстрее, но может пропустить мелкие детали.",
          "kz": "Свертка терезесінің әр қадамдағы жылжуын анықтайды."
        }
      },
      "window": {
        "label": {
          "en": "window",
          "ru": "Размер окна",
          "kz": "window"
        },
        "description": {
          "en": "Sets the convolution kernel size.",
          "ru": "Задаёт размер участка, который фильтр рассматривает за один раз, например 3 × 3 пикселя.",
          "kz": "Свертка ядросының өлшемін анықтайды."
        }
      }
    },
    "connects_to": [],
    "examples": [
      {
        "body": {
          "ru": "Для первого распознавания цифр можно взять 8 фильтров, окно 3 × 3 и шаг 1. Слой будет искать восемь разных видов простых деталей.",
          "en": "For basic digit recognition, start with 8 filters of size 3 × 3 and a stride of 1.",
          "kz": "Цифрларды қарапайым тану үшін өлшемі 3 × 3 болатын 8 сүзгіден және 1 қадамнан бастаңыз."
        }
      }
    ]
