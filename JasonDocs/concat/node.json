  "docs": {
    "title": {
      "en": "Concatenate",
      "ru": "Объединение",
      "kz": "Біріктіру"
    },
    "summary": {
      "en": "Joins several one-dimensional feature branches into one vector.",
      "ru": "Склеивает несколько цепочек чисел в одну общую цепочку.",
      "kz": "Бірнеше бір өлшемді белгілер тармағын бір векторға біріктіреді."
    },
    "operation": {
      "en": "Accepts multiple compatible layer outputs and concatenates them along the feature dimension. The output width is the sum of connected input widths.",
      "ru": "Иногда модель обрабатывает одни и те же данные несколькими путями. Эта нода берёт результаты всех таких веток и записывает их друг за другом в одну длинную цепочку. Числа не смешиваются и не пропадают — каждая ветка сохраняет свою часть общей цепочки.",
      "kz": "Бірнеше үйлесімді қабат шығысын қабылдап, оларды белгілер өлшемі бойынша біріктіреді. Шығыс ені кіріс ендерінің қосындысына тең."
    },
    "compact": {
      "body": {
        "en": "Joins several one-dimensional feature branches into one vector.",
