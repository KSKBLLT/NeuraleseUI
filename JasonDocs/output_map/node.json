  "docs": {
    "title": {
      "en": "OutputMap",
      "ru": "Подготовка ответа",
      "kz": "Шығыс картасы"
    },
    "summary": {
      "en": "Maps raw model outputs to the values required by the training step.",
      "ru": "Соединяет предсказание модели с правильным ответом из учебного примера.",
      "kz": "Өңделмеген модель шығысын оқу қадамына қажет мәндермен сәйкестендіреді."
    },
    "operation": {
      "en": "Receives model output and creates mapped training outputs through its configurable rows. The mapped result is consumed by Training Step.",
      "ru": "Чтобы модель могла учиться, нужно сравнить её предсказание с правильным ответом. Эта нода получает оба результата и указывает, какие числа нужно сравнить между собой. После этого подготовленная пара отправляется в ноду «Шаг обучения», которая вычисляет ошибку и исправляет модель.",
      "kz": "Модель шығысын қабылдап, бапталатын жолдар арқылы сәйкестендірілген оқу мәндерін жасайды. Нәтижені Training Step қолданады."
    },
    "compact": {
      "body": {
        "en": "Maps raw model outputs to the values required by the training step.",
        "ru": "Готовит предсказание и правильный ответ к сравнению.",
        "kz": "Өңделмеген модель шығысын оқу қадамына қажет мәндермен сәйкестендіреді."
      }
    },
    "ports": {
