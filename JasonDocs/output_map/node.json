        "label": {
          "en": "model_in",
          "ru": "Предсказание модели",
          "kz": "model_in"
        },
        "description": {
          "en": "Receives model_output data through the model_in input.",
          "ru": "Фиолетовый порт слева принимает ответ от ноды «Запуск модели».",
          "kz": "model_in кірісі арқылы model_output түріндегі деректерді қабылдайды."
        }
