  "docs": {
    "title": {
      "en": "MaxPool2D",
      "ru": "MaxPool",
      "kz": "2D макс-пулинг"
    },
    "summary": {
      "en": "Downsamples a two-dimensional feature map by keeping local maxima.",
      "ru": "Сжимает сетки, оставляя самые сильные ответы на каждом участке.",
      "kz": "Жергілікті максимумдарды сақтап, екі өлшемді белгілер картасын кішірейтеді."
    },
    "operation": {
      "en": "Splits the feature map into pooling regions and keeps the largest value in each region. This reduces spatial size while retaining strong activations.",
      "ru": "MaxPool делит каждую сетку на небольшие участки и оставляет из каждого участка только самое большое число. Так сетка становится меньше, но заметные детали сохраняются. Следующим слоям приходится обрабатывать меньше чисел, а небольшое смещение детали на изображении меньше влияет на результат.",
      "kz": "Белгілер картасын аймақтарға бөліп, әр аймақтағы ең үлкен мәнді сақтайды. Бұл күшті белсендірулерді сақтап, кеңістік өлшемін азайтады."
    },
    "compact": {
      "body": {
        "en": "Downsamples a two-dimensional feature map by keeping local maxima.",
        "ru": "Сжимает сетки и сохраняет самые сильные ответы.",
        "kz": "Жергілікті максимумдарды сақтап, екі өлшемді белгілер картасын кішірейтеді."
      }
    },
