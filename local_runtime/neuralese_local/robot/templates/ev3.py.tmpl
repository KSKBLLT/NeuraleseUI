#!/usr/bin/env python3
# {{BANNER}}
#
# Robot: LEGO MINDSTORMS EV3 running ev3dev
# Link:  TCP over the USB cable
#
# The EV3 has no USB serial port -- plugging it in gives it a network connection
# instead. So this program waits on the brick for the computer to connect, then
# streams sensor readings and applies the commands that come back.
#
# This program does not contain the neural network. The computer runs the model,
# which is why this program never has to change when you train a new one.
#
# Safety: if the computer stops answering for {{WATCHDOG_MS}} ms, every motor is
# stopped automatically.
#
# To use it: copy this file onto the brick and run it, then press Connect in
# Neuralese on the computer.

import select
import socket
import sys
import time

from ev3dev2.sensor import INPUT_1, INPUT_2, INPUT_3, INPUT_4
{{IMPORTS}}

PROTOCOL = {{PROTOCOL}}
PLATFORM = "{{PLATFORM_ID}}"
CFG_HASH = "{{CFG_HASH}}"
N_IN = {{N_IN}}
N_OUT = {{N_OUT}}
RATE_HZ = {{RATE_HZ}}
PERIOD_S = {{PERIOD_MS}} / 1000.0
WATCHDOG_S = {{WATCHDOG_MS}} / 1000.0
SEQ_MOD = {{SEQ_MOD}}
MAX_LINE = {{MAX_LINE}}
LISTEN_PORT = {{TCP_PORT}}
SAFE = {{SAFE_VALUES}}

{{SETUP}}

# Writing a sysfs attribute is a real file write, so repeating an unchanged
# motor command 20 times a second is pure wasted I/O on a 300 MHz brick.
_last_motor_command = {}


def _drive_motor(motor, percent):
    percent = max(-100, min(100, int(percent)))
    if _last_motor_command.get(id(motor)) == percent:
        return
    if percent == 0:
        motor.stop()
    else:
        motor.run_forever(speed_sp=int(percent * motor.max_speed / 100))
    # Remembered only after the write succeeded. Writing a sysfs attribute can
    # raise, and recording the command first would leave this believing the
    # motor had stopped when it had not -- so a retry would return early and the
    # motor would keep running.
    _last_motor_command[id(motor)] = percent


def _crc(text):
    total = 0
    for byte in text.encode("ascii"):
        total += byte
    return total & 0xFFFF


def _encode(payload):
    return (payload + "," + ("%04x" % _crc(payload)) + "\n").encode("ascii")


def _parse(line):
    # Returns the split fields, or None if the line is damaged. A half-received
    # line must never be acted on: it can decode as a plausible motor command.
    index = line.rfind(",")
    if index < 0:
        return None
    head = line[:index]
    try:
        if int(line[index + 1:], 16) != _crc(head):
            return None
    except Exception:
        return None
    return head.split(",")


def read_sensors():
    return [{{READ_SENSORS}}]


def apply_outputs(values):
{{APPLY_ACTUATORS}}


def safe_stop():
    apply_outputs(SAFE)


def serve_one_session(connection):
    # The motors are stopped on every way out of this function -- the computer
    # closing the socket, an error, a stop command -- and not only in the caller.
    # This is the one function that starts the motors, so it is the one that has
    # to guarantee they stop. The watchdog below cannot cover a closed socket,
    # because the loop exits before the watchdog gets a chance to fire.
    try:
        _serve_one_session(connection)
    finally:
        safe_stop()


def _serve_one_session(connection):
    connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    connection.setblocking(False)

    hello = "H,%d,%s,%s,%d,%d,%d,%d" % (
        PROTOCOL, PLATFORM, CFG_HASH, N_IN, N_OUT, RATE_HZ, {{WATCHDOG_MS}})

    buffer = ""
    connected = False
    last_hello = 0.0

    while not connected:
        now = time.monotonic()
        if now - last_hello >= 0.25:
            connection.sendall(_encode(hello))
            last_hello = now
        readable, _, _ = select.select([connection], [], [], 0.05)
        if readable:
            chunk = connection.recv(4096)
            if not chunk:
                return
            buffer += chunk.decode("ascii", "ignore")
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                fields = _parse(line.strip())
                if not fields:
                    continue
                if fields[0] == "K":
                    connected = True
                elif fields[0] == "E":
                    print("Neuralese refused the connection: %s" % (fields[1] if len(fields) > 1 else "?"))
                    return

    print("Connected. Running the model.")
    seq = 0
    last_send = time.monotonic()
    last_command = time.monotonic()
    stopped = False

    while True:
        now = time.monotonic()

        readable, _, _ = select.select([connection], [], [], 0.002)
        if readable:
            chunk = connection.recv(4096)
            if not chunk:
                break
            buffer += chunk.decode("ascii", "ignore")
            if len(buffer) > MAX_LINE and "\n" not in buffer:
                buffer = ""
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                fields = _parse(line.strip())
                if not fields:
                    continue
                kind = fields[0]
                if kind == "A" and len(fields) == N_OUT + 2:
                    try:
                        values = [int(field) for field in fields[2:]]
                    except Exception:
                        continue
                    apply_outputs(values)
                    last_command = now
                    stopped = False
                elif kind == "K":
                    # A fresh computer accepted us after the old one went away.
                    last_command = now
                    stopped = False
                elif kind == "X":
                    safe_stop()
                    return
                elif kind == "E":
                    print("Neuralese stopped the robot: %s" % (fields[1] if len(fields) > 1 else "?"))
                    safe_stop()
                    return

        # Watchdog. The computer answers every reading, so silence means the
        # link is gone -- and a robot that keeps its last motor command after
        # losing the link is a robot that drives into something.
        if not stopped and now - last_command > WATCHDOG_S:
            safe_stop()
            stopped = True
            print("Lost the computer. Motors stopped.")

        if stopped and now - last_hello >= 0.25:
            # The computer has gone quiet without closing the socket. Start
            # announcing ourselves again so that when Neuralese comes back it
            # can complete a fresh handshake -- it is not allowed to act on
            # sensor readings from a robot it has not agreed a mapping with.
            connection.sendall(_encode(hello))
            last_hello = now

        if now - last_send >= PERIOD_S:
            last_send = now
            seq = (seq + 1) % SEQ_MOD
            payload = "S," + str(seq)
            for value in read_sensors():
                payload += "," + str(int(value))
            connection.sendall(_encode(payload))


def main():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("0.0.0.0", LISTEN_PORT))
    server.listen(1)
    print("Waiting for Neuralese on port %d..." % LISTEN_PORT)

    try:
        while True:
            connection, address = server.accept()
            print("Computer connected from %s" % (address[0],))
            try:
                serve_one_session(connection)
            except (OSError, ConnectionError) as exc:
                print("Connection lost: %s" % exc)
            finally:
                # Whatever went wrong, the motors stop before we go back to
                # waiting. This is the one guarantee the whole program exists for.
                safe_stop()
                try:
                    connection.close()
                except Exception:
                    pass
                print("Waiting for Neuralese again...")
    except KeyboardInterrupt:
        pass
    finally:
        safe_stop()
        server.close()


if __name__ == "__main__":
    sys.exit(main())
