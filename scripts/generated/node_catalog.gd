static func has(type_id: StringName) -> bool:
	return DEFINITIONS.has(type_id)


static func source_map() -> Dictionary:
	var result := SCENE_PATHS.duplicate()
	for type_id in PROVIDER_PATHS:
		result[type_id] = PROVIDER_PATHS[type_id]
	return result


static func load_order() -> Array[StringName]:
	var result: Array[StringName] = []
	for type_id in DEFINITIONS:
		result.append(type_id)
	result.sort_custom(func(a, b): return DEFINITIONS[a].load_order < DEFINITIONS[b].load_order)
	return result


static func _menu_before(a: StringName, b: StringName) -> bool:
	var a_definition: Dictionary = DEFINITIONS[a]
	var b_definition: Dictionary = DEFINITIONS[b]
	if a_definition.menu_order == b_definition.menu_order:
		return a_definition.load_order < b_definition.load_order
	return a_definition.menu_order < b_definition.menu_order


static func menu_order() -> Array[StringName]:
	var result: Array[StringName] = []
	for type_id in DEFINITIONS:
		if DEFINITIONS[type_id].menu_visible:
			result.append(type_id)
	result.sort_custom(_menu_before)
	return result


static func input_types() -> Array[StringName]:
	var result: Array[StringName] = []
	for type_id in DEFINITIONS:
		if "input" in DEFINITIONS[type_id].roles:
			result.append(type_id)
	return result


static func button_definitions() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for type_id in menu_order():
		var definition: Dictionary = DEFINITIONS[type_id]
		result.append({
			"name": type_id,
			"title": definition.title.en,
			"title_ru": definition.title.ru,
			"title_kz": definition.title.kz,
			"outline_color": definition.outline_color,
			"tuning": definition.tuning,
			"category": definition.category,
			"menu_visible": definition.menu_visible,
			"menu_section": definition.menu_section,
			"menu_order": definition.menu_order,
			"load_order": definition.load_order,
			"aliases": definition.llm_aliases,
		})
	return result


static func llm_name_mapping() -> Dictionary:
	var result := {}
	for type_id in DEFINITIONS:
		var definition: Dictionary = DEFINITIONS[type_id]
		for alias in definition.llm_aliases:
			result[StringName(alias)] = type_id
	return result


static func llm_name_unmapping() -> Dictionary:
	var result := {}
	for type_id in DEFINITIONS:
		result[type_id] = DEFINITIONS[type_id].llm_type
	return result
