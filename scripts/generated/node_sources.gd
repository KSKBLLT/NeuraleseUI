func source_count() -> int:
	return SCENES.size() + PROVIDERS.size()


func _enter_tree() -> void:
	super()
	if not OS.has_feature("editor"):
		return
	if "--node-dev-validate" not in OS.get_cmdline_user_args():
		return
	var errors: Array[String] = []
	if source_count() != NodeCatalog.DEFINITIONS.size():
		errors.append("source count does not match definitions")
	for type_id in NodeCatalog.load_order():
		if SCENES.has(type_id):
			if not SCENES[type_id].can_instantiate():
				errors.append("%s is not an instantiable PackedScene" % type_id)
				continue
		elif PROVIDERS.has(type_id):
			if not PROVIDERS[type_id].can_instantiate():
				errors.append("%s is not an instantiable provider Script" % type_id)
				continue
		else:
			errors.append("%s has no generated source" % type_id)
			continue
		var created := instantiate_node(type_id)
		if not is_instance_valid(created):
			errors.append("%s source returned no node" % type_id)
			continue
		if not (created is Graph):
			errors.append("%s source did not create a Graph" % type_id)
		created.free()
	if errors.is_empty():
		print("NODE_DEV_SOURCES_OK: %d" % source_count())
		get_tree().quit(0)
		return
	for error in errors:
		push_error("NODE_DEV: %s" % error)
	get_tree().quit(1)


func instantiate_node(type_id: StringName) -> Node:
	if SCENES.has(type_id):
		return SCENES[type_id].instantiate()
	if PROVIDERS.has(type_id):
		var provider = PROVIDERS[type_id].new()
		var created = provider.instantiate_node(NodeCatalog.DEFINITIONS[type_id].duplicate(true))
		return created as Node
	push_error("Unknown graph node type: %s" % type_id)
	return null
